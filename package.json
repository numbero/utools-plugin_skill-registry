{
  "name": "utools-plugin-skillregistory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SkillRegistory 的 uTools 本机管理插件",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
